[Unit]
Description=Go Guest Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guest-agent
Group=guest-agent
ExecStart=/usr/local/bin/go-guest-agent -gateway https://gateway.example -state-file /var/lib/go-guest-agent/id -workspace /var/lib/go-guest-agent/workspace -auth-token-file /etc/go-guest-agent/token
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/go-guest-agent

[Install]
WantedBy=multi-user.target
